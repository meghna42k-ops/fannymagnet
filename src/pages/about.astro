---
import Base from '../layouts/Base.astro';
import KleapForm from '../components/KleapForm';
---
<Base title="About FANNYMAGNET — Contact" description="Learn about FANNYMAGNET and contact the independent sports science publication."><main class="page"><a class="back" href="/">← FANNYMAGNET</a><p class="kicker">ABOUT / CONTACT</p><h1>Ask better questions.</h1><p class="intro">FANNYMAGNET is an independent publication about bodybuilding, sports chemistry, performance science and the substances that influence the human body.</p><section><h2>Editorial independence.</h2><p>We separate education from commerce, evidence from hype, and medical treatment from non-medical performance enhancement. The aim is context, not certainty theater.</p></section><section id="contact"><h2>Contact the desk.</h2><KleapForm client:load formId="contact" title="Send a message" fields={[{name:'name',label:'Name',type:'text',required:true},{name:'email',label:'Email',type:'email',required:true},{name:'message',label:'Message',type:'textarea',required:true}]} submitText="SEND MESSAGE" /></section></main></Base>
<style>.page{max-width:950px;margin:auto;padding:38px 5vw 100px}.back{color:inherit;text-decoration:none;font-weight:800}.kicker{color:#dc143c;letter-spacing:.15em;margin-top:100px}.page h1{font-size:clamp(60px,10vw,135px);line-height:.9;letter-spacing:-.08em}.intro{font-size:21px;color:#aaa99e;max-width:650px;line-height:1.5}section{border-top:1px solid #3c3d34;margin-top:80px;padding-top:30px;max-width:700px}section h2{font-size:38px}section p{color:#aaa99e;line-height:1.7}</style>