<style>.page{max-width:1180px;margin:auto;padding:38px 5vw 100px}.back{color:inherit;text-decoration:none;font-weight:800;letter-spacing:.08em}.kicker{margin-top:100px;color:#dc143c;letter-spacing:.15em;font-size:12px}.page h1{font-size:clamp(58px,10vw,140px);line-height:.9;margin:20px 0;letter-spacing:-.07em}.intro{max-width:570px;color:#aaa99e;font-size:20px;line-height:1.5}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:#3c3d34;margin-top:70px}.grid a{background:#10110e;color:#eeeae0;padding:34px;text-decoration:none;min-height:220px}.grid a:hover h2{color:#dc143c}.grid b{color:#dc143c}.grid h2{font-size:30px;margin:30px 0 12px}.grid p{color:#aaa99e;line-height:1.6}@media(max-width:650px){.grid{grid-template-columns:1fr}.page{padding-top:24px}.kicker{margin-top:70px}}</style>