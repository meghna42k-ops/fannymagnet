---
import Base from '../layouts/Base.astro';
import ManagedContent from '../components/ManagedContent';
---
<Base title="Nutrition Store — FANNYMAGNET" description="A considered store for legitimate, clearly labelled sports nutrition basics."><main class="page"><a class="back" href="/">← FANNYMAGNET</a><p class="kicker">NUTRITION STORE / VERIFIED BASICS</p><h1>Fuel, not fiction.</h1><p class="intro">A curated starting point for clearly labelled sports nutrition. Product details, ingredients and warnings belong before the checkout button.</p><ManagedContent client:load kind="products" /><div class="products"><article id="protein"><b>01</b><h2>Protein in focus</h2><p>Whey and plant protein categories, with manufacturer-labelled ingredients and allergen information.</p><a href="/chemistry#protein">UNDERSTAND PROTEIN ↗</a></article><article id="creatine"><b>02</b><h2>Creatine. No mystery.</h2><p>Creatine monohydrate category study. Product information will be shown from verified labels.</p><a href="/chemistry#creatine">UNDERSTAND CREATINE ↗</a></article><article><b>03</b><h2>Hydration & performance</h2><p>Electrolytes, pre-workout and everyday training accessories, clearly separated by use.</p><a href="/cart">VIEW BAG ↗</a></article></div><p class="note">Products shown here are educational category placeholders until verified inventory is connected. No unverified claims or reviews are presented.</p></main></Base>
<style>.page{max-width:1100px;margin:auto;padding:38px 5vw 100px}.back{color:inherit;text-decoration:none;font-weight:800}.kicker{color:#dc143c;letter-spacing:.15em;margin-top:100px}.page h1{font-size:clamp(60px,10vw,140px);line-height:.9;letter-spacing:-.08em}.intro{font-size:21px;color:#aaa99e;max-width:620px;line-height:1.5}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#3c3d34;margin-top:70px}.products article{background:#10110e;padding:30px;min-height:280px}.products b{color:#dc143c}.products h2{font-size:30px;margin-top:55px}.products p,.note{color:#aaa99e;line-height:1.6}.products a{display:inline-block;margin-top:24px;color:#dc143c;text-decoration:none;font-weight:800}.note{border-top:1px solid #3c3d34;margin-top:40px;padding-top:20px}@media(max-width:750px){.products{grid-template-columns:1fr}}</style>