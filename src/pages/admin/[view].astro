---
import Base from '../../layouts/Base.astro';
import AdminPanel from '../../components/AdminPanel';
export function getStaticPaths() {
  return [{ params: { view: 'login' } }, { params: { view: 'dashboard' } }];
}
const view=Astro.params.view;
---
<Base title={view === 'login' ? 'Administrator Sign-In — FANNYMAGNET' : 'Administration Dashboard — FANNYMAGNET'} description={view === 'login' ? 'Secure sign-in for authorised FANNYMAGNET administrators. Access your private account to manage the publication and nutrition store.' : 'Private FANNYMAGNET dashboard for authorised administrators to manage products, inventory, orders, editorial content and website settings.'} noindex><h1 class="sr-only">{view === 'login' ? 'Administrator sign-in' : 'Administration dashboard'}</h1><AdminPanel client:only="react" view={view}/></Base>
