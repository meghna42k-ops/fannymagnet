---
import Base from '../layouts/Base.astro';
import { UserButton } from '../components/auth/KleapAuth';
---
<Base title="Account — FANNYMAGNET" description="Manage your FANNYMAGNET account, saved reading and orders." noindex><main class="page"><a class="back" href="/">← FANNYMAGNET</a><p class="kicker">MEMBER AREA</p><h1>Your account.</h1><p class="intro">Sign in to manage your profile and keep your place across the archive.</p><div class="panel"><UserButton client:only="react" /></div><a class="text" href="/journal">RETURN TO THE JOURNAL ↗</a><p><a class="text" href="/admin/login">ADMINISTRATOR SIGN-IN ↗</a></p></main></Base>
<style>.page{max-width:850px;margin:auto;padding:38px 5vw 100px}.back{color:inherit;text-decoration:none;font-weight:800}.kicker{color:#dc143c;letter-spacing:.15em;margin-top:110px}.page h1{font-size:clamp(60px,10vw,130px);line-height:.9;letter-spacing:-.08em}.intro{font-size:21px;color:#aaa99e;line-height:1.5}.panel{border:1px solid #3c3d34;padding:30px;margin:60px 0}.text{color:#dc143c;text-decoration:none;font-weight:800}</style>